# Copy to .env (never commit .env). Keep the real values in the company password manager.

POSTGRES_PASSWORD=
GRAFANA_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# GitHub: read-only fine-grained token on the repositories to measure
#   Pull requests: read · Contents: read · Deployments: read · Metadata: read
GITHUB_TOKEN=

# Claude Code — pick according to the plan (see README):
#   Claude Console (API billing): Admin API key (console → Settings → Admin keys)
ANTHROPIC_ADMIN_KEY=
#   Team/Enterprise subscription: OpenTelemetry. Shared secret Claude Code sends in the Authorization header.
OTEL_INGEST_TOKEN=

# Cursor: dashboard → Settings → Cursor Admin API Keys
CURSOR_ADMIN_KEY=

# Token for POST /events/deployment and /events/incident
EVENTS_TOKEN=

# Days to re-import from the AI tool APIs on each run (covers late-arriving data)
LOOKBACK_DAYS=30

# On a server, bind both ports to localhost and put them behind an HTTPS reverse proxy:
# API_PORT=127.0.0.1:8080
# GRAFANA_PORT=127.0.0.1:3000
