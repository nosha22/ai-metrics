# Copiar para .env (nunca fazer commit do .env). Guardar os valores reais no 1Password.

POSTGRES_PASSWORD=
GRAFANA_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# GitHub: fine-grained token só de leitura nos repositórios a medir
#   Pull requests: read · Contents: read · Deployments: read · Metadata: read
GITHUB_TOKEN=

# Claude Code — escolher conforme o plano (ver README):
#   Claude Console (API): Admin API key (console → Settings → Admin keys)
ANTHROPIC_ADMIN_KEY=
#   Subscrição Team/Enterprise: OpenTelemetry. Token partilhado que o Claude Code envia no header Authorization.
OTEL_INGEST_TOKEN=

# Cursor: dashboard → Settings → Cursor Admin API Keys
CURSOR_ADMIN_KEY=

# Token para POST /events/deployment e /events/incident
EVENTS_TOKEN=

# Dias a reimportar das APIs de IA em cada execução (corrige atrasos de dados)
LOOKBACK_DAYS=30
