{
  "uid": "ai-impact",
  "title": "AI · PR impact",
  "description": "AI-assisted PRs vs the rest: throughput, cycle time, review time and size.",
  "tags": [
    "ai-metrics"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "team",
        "label": "Team",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "aimetrics-pg"
        },
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1,
        "query": "SELECT name FROM teams UNION SELECT '(no team)' ORDER BY 1",
        "definition": "SELECT name FROM teams"
      },
      {
        "name": "high_only",
        "label": "High confidence only",
        "type": "custom",
        "query": "false,true",
        "current": {
          "text": "false",
          "value": "false"
        },
        "options": [
          {
            "text": "false",
            "value": "false",
            "selected": true
          },
          {
            "text": "true",
            "value": "true",
            "selected": false
          }
        ],
        "description": "true = ignore the 24-hour rule (fewer false positives, some undercounting)"
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "A PR is **AI-assisted** if a commit has an AI co-author, trailer or author, if it has the tool's label, if Git AI recorded AI lines, or (low confidence) if the author used the tool in the 24 hours before a commit. See the reason for each PR in the table at the bottom. Median and p75 limit the effect of outliers."
      },
      "id": 1,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    },
    {
      "type": "stat",
      "title": "PRs with AI",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT avg(CASE WHEN CASE WHEN (${high_only} AND ai_assisted_high) OR (NOT ${high_only} AND ai_assisted) THEN 'With AI' ELSE 'Without AI' END = 'With AI' THEN 1 ELSE 0 END) FROM v_pr_facts WHERE $__timeFilter(merged_at) AND team IN (${team:sqlstring})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 2,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    },
    {
