      }
    },
    {
      "type": "timeseries",
      "title": "Median cycle time per week",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT merged_week AS time, CASE WHEN (${high_only} AND ai_assisted_high) OR (NOT ${high_only} AND ai_assisted) THEN 'With AI' ELSE 'Without AI' END AS metric, percentile_cont(0.5) WITHIN GROUP (ORDER BY cycle_time_h) AS value FROM v_pr_facts WHERE $__timeFilter(merged_at) AND team IN (${team:sqlstring}) GROUP BY 1,2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 11,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    },
    {
      "type": "table",
      "title": "By tool",
      "description": "A PR with two tools counts once in each (as in Swarmia).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COALESCE(t, 'No AI') AS \"Tool\", count(*) AS \"PRs\", percentile_cont(0.5) WITHIN GROUP (ORDER BY cycle_time_h) AS \"Cycle time (median)\", percentile_cont(0.5) WITHIN GROUP (ORDER BY review_time_h) AS \"Review (median)\", percentile_cont(0.5) WITHIN GROUP (ORDER BY batch_size) AS \"Batch size (median)\" FROM v_pr_facts LEFT JOIN LATERAL unnest(NULLIF(ai_tools, '{}')) t ON TRUE WHERE $__timeFilter(merged_at) AND team IN (${team:sqlstring}) GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cycle time (median)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "h"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Review (median)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "h"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "id": 12,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    },
    {
      "type": "row",
      "title": "Details",
      "id": 13,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "PRs and attribution reason",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT f.merged_at AS \"Merged\", f.repo || '#' || f.number AS \"PR\", f.title AS \"Title\", f.person AS \"Person\", string_agg(a.tool || ' · ' || a.mode || ' · ' || a.confidence || ': ' || a.reason, E'\\n' ORDER BY a.tool) AS \"Attribution\", f.cycle_time_h AS \"Cycle time\", f.batch_size AS \"Batch\" FROM v_pr_facts f LEFT JOIN pr_ai_attribution a ON a.pr_id = f.pr_id WHERE $__timeFilter(f.merged_at) AND f.team IN (${team:sqlstring}) GROUP BY f.pr_id, f.merged_at, f.repo, f.number, f.title, f.person, f.cycle_time_h, f.batch_size ORDER BY 1 DESC LIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cycle time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "h"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "id": 14,
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    }
  ]
