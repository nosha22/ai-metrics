    {
      "type": "row",
      "title": "Detalhe",
      "id": 13,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "PRs e motivo da atribuição",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT f.merged_at AS \"Merged\", f.repo || '#' || f.number AS \"PR\", f.title AS \"Título\", f.person AS \"Pessoa\", string_agg(a.tool || ' · ' || a.mode || ' · ' || a.confidence || ': ' || a.reason, E'\\n' ORDER BY a.tool) AS \"Atribuição\", f.cycle_time_h AS \"Cycle time\", f.batch_size AS \"Batch\" FROM v_pr_facts f LEFT JOIN pr_ai_attribution a ON a.pr_id = f.pr_id WHERE $__timeFilter(f.merged_at) AND f.team IN (${team:sqlstring}) GROUP BY f.pr_id, f.merged_at, f.repo, f.number, f.title, f.person, f.cycle_time_h, f.batch_size ORDER BY 1 DESC LIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cycle time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "h"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "id": 14,
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 35
