    {
      "type": "timeseries",
      "title": "Share de PRs com IA por semana",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT merged_week AS time, avg(CASE WHEN CASE WHEN (${high_only} AND ai_assisted_high) OR (NOT ${high_only} AND ai_assisted) THEN 'Com IA' ELSE 'Sem IA' END = 'Com IA' THEN 1 ELSE 0 END) AS \"PRs com IA\", avg(cloud_agent::int) AS \"PRs de agentes\", avg(review_agent::int) AS \"Review de IA\" FROM v_pr_facts WHERE $__timeFilter(merged_at) AND team IN (${team:sqlstring}) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
