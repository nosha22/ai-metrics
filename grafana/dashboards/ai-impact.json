    {
      "type": "barchart",
      "title": "Cycle time: mediana e p75",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT CASE WHEN (${high_only} AND ai_assisted_high) OR (NOT ${high_only} AND ai_assisted) THEN 'Com IA' ELSE 'Sem IA' END AS \"Grupo\", percentile_cont(0.5) WITHIN GROUP (ORDER BY cycle_time_h) AS \"Mediana\", percentile_cont(0.75) WITHIN GROUP (ORDER BY cycle_time_h) AS \"p75\" FROM v_pr_facts WHERE $__timeFilter(merged_at) AND team IN (${team:sqlstring}) AND cycle_time_h IS NOT NULL GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": 0,
        "groupWidth": 0.7,
        "barWidth": 0.9
      },
      "id": 8,
      "gridPos": {
