          "rawSql": "SELECT CASE WHEN (${high_only} AND ai_assisted_high) OR (NOT ${high_only} AND ai_assisted) THEN 'Com IA' ELSE 'Sem IA' END AS \"Grupo\", percentile_cont(0.5) WITHIN GROUP (ORDER BY review_time_h) AS \"Mediana\", percentile_cont(0.75) WITHIN GROUP (ORDER BY review_time_h) AS \"p75\" FROM v_pr_facts WHERE $__timeFilter(merged_at) AND team IN (${team:sqlstring}) AND review_time_h IS NOT NULL GROUP BY 1 ORDER BY 1"
