    {
      "type": "table",
      "title": "Por ferramenta",
      "description": "Um PR com duas ferramentas conta uma vez em cada (como no Swarmia).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COALESCE(t, 'Sem IA') AS \"Ferramenta\", count(*) AS \"PRs\", percentile_cont(0.5) WITHIN GROUP (ORDER BY cycle_time_h) AS \"Cycle time (mediana)\", percentile_cont(0.5) WITHIN GROUP (ORDER BY review_time_h) AS \"Review (mediana)\", percentile_cont(0.5) WITHIN GROUP (ORDER BY batch_size) AS \"Batch size (mediana)\" FROM v_pr_facts LEFT JOIN LATERAL unnest(NULLIF(ai_tools, '{}')) t ON TRUE WHERE $__timeFilter(merged_at) AND team IN (${team:sqlstring}) GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cycle time (mediana)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "h"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Review (mediana)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "h"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
