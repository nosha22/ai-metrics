    {
      "type": "timeseries",
      "title": "Share of PRs with AI per week",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT merged_week AS time, avg(CASE WHEN CASE WHEN (${high_only} AND ai_assisted_high) OR (NOT ${high_only} AND ai_assisted) THEN 'With AI' ELSE 'Without AI' END = 'With AI' THEN 1 ELSE 0 END) AS \"PRs with AI\", avg(cloud_agent::int) AS \"Agent PRs\", avg(review_agent::int) AS \"AI review\" FROM v_pr_facts WHERE $__timeFilter(merged_at) AND team IN (${team:sqlstring}) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    },
    {
      "type": "timeseries",
      "title": "Throughput (merged PRs per week)",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT merged_week AS time, CASE WHEN (${high_only} AND ai_assisted_high) OR (NOT ${high_only} AND ai_assisted) THEN 'With AI' ELSE 'Without AI' END AS metric, count(*) AS value FROM v_pr_facts WHERE $__timeFilter(merged_at) AND team IN (${team:sqlstring}) GROUP BY 1,2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 60,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    },
    {
      "type": "barchart",
      "title": "Cycle time: median and p75",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT CASE WHEN (${high_only} AND ai_assisted_high) OR (NOT ${high_only} AND ai_assisted) THEN 'With AI' ELSE 'Without AI' END AS \"Group\", percentile_cont(0.5) WITHIN GROUP (ORDER BY cycle_time_h) AS \"Median\", percentile_cont(0.75) WITHIN GROUP (ORDER BY cycle_time_h) AS \"p75\" FROM v_pr_facts WHERE $__timeFilter(merged_at) AND team IN (${team:sqlstring}) AND cycle_time_h IS NOT NULL GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": 0,
        "groupWidth": 0.7,
        "barWidth": 0.9
      },
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    },
    {
      "type": "barchart",
      "title": "Time to first human review: median and p75",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT CASE WHEN (${high_only} AND ai_assisted_high) OR (NOT ${high_only} AND ai_assisted) THEN 'With AI' ELSE 'Without AI' END AS \"Group\", percentile_cont(0.5) WITHIN GROUP (ORDER BY review_time_h) AS \"Median\", percentile_cont(0.75) WITHIN GROUP (ORDER BY review_time_h) AS \"p75\" FROM v_pr_facts WHERE $__timeFilter(merged_at) AND team IN (${team:sqlstring}) AND review_time_h IS NOT NULL GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": 0,
        "groupWidth": 0.7,
        "barWidth": 0.9
      },
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 17
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    },
    {
      "type": "barchart",
      "title": "Batch size (lines +/−): median and p75",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT CASE WHEN (${high_only} AND ai_assisted_high) OR (NOT ${high_only} AND ai_assisted) THEN 'With AI' ELSE 'Without AI' END AS \"Group\", percentile_cont(0.5) WITHIN GROUP (ORDER BY batch_size) AS \"Median\", percentile_cont(0.75) WITHIN GROUP (ORDER BY batch_size) AS \"p75\" FROM v_pr_facts WHERE $__timeFilter(merged_at) AND team IN (${team:sqlstring}) AND batch_size IS NOT NULL GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
