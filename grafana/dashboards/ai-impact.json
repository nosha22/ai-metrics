          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT CASE WHEN (${high_only} AND ai_assisted_high) OR (NOT ${high_only} AND ai_assisted) THEN 'Com IA' ELSE 'Sem IA' END AS \"Grupo\", percentile_cont(0.5) WITHIN GROUP (ORDER BY batch_size) AS \"Mediana\", percentile_cont(0.75) WITHIN GROUP (ORDER BY batch_size) AS \"p75\" FROM v_pr_facts WHERE $__timeFilter(merged_at) AND team IN (${team:sqlstring}) AND batch_size IS NOT NULL GROUP BY 1 ORDER BY 1"
