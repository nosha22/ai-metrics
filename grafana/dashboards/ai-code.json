{
  "uid": "ai-code",
  "title": "AI · Generated code & quality",
  "description": "Share of AI code (Git AI), line survival and change failure rate.",
  "tags": [
    "ai-metrics"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "team",
        "label": "Team",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "aimetrics-pg"
        },
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1,
        "query": "SELECT name FROM teams UNION SELECT '(no team)' ORDER BY 1",
        "definition": "SELECT name FROM teams"
      },
      {
        "name": "high_only",
        "label": "High confidence only",
        "type": "custom",
        "query": "false,true",
        "current": {
          "text": "false",
          "value": "false"
        },
        "options": [
          {
            "text": "false",
            "value": "false",
            "selected": true
          },
          {
            "text": "true",
            "value": "true",
            "selected": false
          }
        ],
        "description": "true = ignore the 24-hour rule (fewer false positives, some undercounting)"
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "The **share of AI code** comes from Git AI notes and only covers commits made with Git AI installed. Check the coverage next to it before drawing conclusions. **Survival** = lines from each PR that still exist on the main branch (git blame). Never look at the AI share without survival next to it."
      },
      "id": 1,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    },
    {
      "type": "stat",
      "title": "AI code share",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT sum(ai_lines)::numeric / NULLIF(sum(added_lines),0) FROM v_pr_facts WHERE $__timeFilter(merged_at) AND team IN (${team:sqlstring}) AND added_lines > 0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 2,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    },
    {
      "type": "stat",
      "title": "Git AI coverage",
      "description": "Commits with a Git AI note ÷ commits. Below ~80% the AI share is not representative.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT sum(commits_with_note)::numeric / NULLIF(sum(commit_count),0) FROM v_pr_facts WHERE $__timeFilter(merged_at) AND team IN (${team:sqlstring})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 3,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 3
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    },
    {
      "type": "stat",
      "title": "Survival at 30+ days (AI ≥50%)",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT avg(survival_rate) FROM v_survival WHERE age_days >= 30 AND ai_group = 'Mostly AI (>=50%)' AND team IN (${team:sqlstring})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 4,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 3
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    },
    {
      "type": "stat",
      "title": "Survival at 30+ days (no AI)",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT avg(survival_rate) FROM v_survival WHERE age_days >= 30 AND ai_group = 'No AI' AND team IN (${team:sqlstring})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 5,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 3
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    },
    {
      "type": "timeseries",
      "title": "AI code share per week",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT merged_week AS time, team AS metric, sum(ai_lines)::numeric / NULLIF(sum(added_lines),0) AS value FROM v_pr_facts WHERE $__timeFilter(merged_at) AND team IN (${team:sqlstring}) AND added_lines > 0 GROUP BY 1,2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    },
    {
      "type": "table",
      "title": "By repository",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT repo AS \"Repo\", sum(ai_lines) AS \"AI lines\", sum(human_lines) AS \"Human lines\", sum(unknown_lines) AS \"Unattested\", sum(ai_lines)::numeric / NULLIF(sum(added_lines),0) AS \"AI share\", sum(commits_with_note)::numeric / NULLIF(sum(commit_count),0) AS \"Coverage\" FROM v_pr_facts WHERE $__timeFilter(merged_at) AND team IN (${team:sqlstring}) GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "AI share"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Coverage"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "id": 7,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    },
    {
      "type": "row",
      "title": "Quality",
      "id": 8,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "type": "barchart",
      "title": "Line survival by PR age",
      "description": "Half-life = the age at which survival drops below 50%. Rework at 30 days = 1 − survival at 30–59 days.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT CASE WHEN age_days < 14 THEN '0–13 days' WHEN age_days < 30 THEN '14–29 days' WHEN age_days < 60 THEN '30–59 days' WHEN age_days < 90 THEN '60–89 days' ELSE '90+ days' END AS \"Age\", avg(survival_rate) FILTER (WHERE ai_group = 'Mostly AI (>=50%)') AS \"Mostly AI\", avg(survival_rate) FILTER (WHERE ai_group = 'Partly AI (<50%)') AS \"Partly AI\", avg(survival_rate) FILTER (WHERE ai_group = 'No AI') AS \"No AI\" FROM v_survival WHERE team IN (${team:sqlstring}) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": 0,
        "groupWidth": 0.7,
        "barWidth": 0.9
      },
      "id": 9,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    },
    {
      "type": "timeseries",
      "title": "Change failure rate (production)",
      "description": "Deployments with an incident ÷ deployments. 'With AI' = the deployment includes at least one AI-assisted PR (high confidence).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT week AS time, ai_group AS metric, cfr AS value FROM v_cfr_weekly WHERE $__timeFilter(week) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 10,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    }
  ]
}
