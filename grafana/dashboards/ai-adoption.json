      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    },
    {
      "type": "stat",
      "title": "Unlinked accounts",
      "description": "Run `aimetrics org unlinked` and add them to organization.yml",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM identities WHERE person_id IS NULL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 5,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 3
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    },
    {
      "type": "timeseries",
      "title": "Weekly active rate by tool",
      "description": "",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT week AS time, tool AS metric, sum(weekly_active)::numeric / NULLIF(sum(members),0) AS value FROM v_adoption_weekly WHERE week >= date_trunc('week', $__timeFrom()::date) AND week <= $__timeTo()::date AND team IN (${team:sqlstring}) GROUP BY 1,2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
