        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT week AS time, tool AS metric, sum(weekly_active) AS value FROM v_adoption_weekly WHERE week >= date_trunc('week', $__timeFrom()::date) AND week <= $__timeTo()::date AND team IN (${team:sqlstring}) GROUP BY 1,2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 60,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          }
