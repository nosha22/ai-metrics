    {
      "type": "stat",
      "title": "Taxa de licenças",
      "description": "Membros com licença ÷ membros, semana atual, todas as ferramentas somadas",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT sum(enabled)::numeric / NULLIF(sum(members),0) FROM v_adoption_weekly WHERE week = date_trunc('week', current_date)::date AND team IN (${team:sqlstring})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
