{
  "uid": "ai-adoption",
  "title": "AI · Adoption",
  "description": "Licenses, active users and idle seats (Swarmia definitions).",
  "tags": [
    "ai-metrics"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "team",
        "label": "Team",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "aimetrics-pg"
        },
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1,
        "query": "SELECT name FROM teams UNION SELECT '(no team)' ORDER BY 1",
        "definition": "SELECT name FROM teams"
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "**Active** = accepted code or used chat during the week. **Licensed** = had a license at some point during the week; for sources without a license list (OpenTelemetry), only people who were active count."
      },
      "id": 1,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    },
    {
      "type": "stat",
      "title": "License rate",
      "description": "Members with a license ÷ members, current week, all tools added together",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT sum(enabled)::numeric / NULLIF(sum(members),0) FROM v_adoption_weekly WHERE week = date_trunc('week', current_date)::date AND team IN (${team:sqlstring})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 2,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    },
    {
      "type": "stat",
      "title": "Active rate (avg)",
      "description": "Weekly average of active members ÷ members. Someone active in two tools counts once per team (max).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT avg(r) FROM (SELECT week, sum(weekly_active)::numeric / NULLIF(sum(members),0) r FROM (SELECT week, team, max(weekly_active) weekly_active, max(members) members FROM v_adoption_weekly WHERE week >= date_trunc('week', $__timeFrom()::date) AND week <= $__timeTo()::date AND team IN (${team:sqlstring}) GROUP BY week, team) x GROUP BY week) w"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 3,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 3
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aimetrics-pg"
      }
    },
    {
      "type": "stat",
      "title": "Idle seats",
      "description": "Active license with no activity in the last 28 days",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aimetrics-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM v_idle_seats WHERE team IN (${team:sqlstring})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
